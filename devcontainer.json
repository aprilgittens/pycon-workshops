{
  "name": "PyCon Workshops",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "pip install pytest",
  "postStartCommand": "npm install -g @github/copilot && bash reset-all.sh",
  "postAttachCommand": "code --open-url 'vscode://vscode.markdown-language-features/markdown-preview?${localWorkspaceFolder}/README.md'",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python"
      ]
    }
  }
}